# Sao chép file này thành `.env` rồi điền key của bạn. File `.env` đã nằm trong .gitignore.
# LLM duy nhất của cuộc thi là claude-haiku-5-5, gọi qua gateway của BTC bằng key cá nhân.

# --- Pipeline của bạn (baseline đọc các biến này) ---
# Key BTC gửi riêng cho bạn, không chia sẻ
OPENAI_API_KEY=
OPENAI_BASE_URL=https://proptit.dekthe.dev/v1
LLM_MODEL=claude-haiku-5-5
# Embedding của baseline, gọi qua gateway bằng cùng key ở trên
EMBEDDING_MODEL=bge-m3

# --- Bộ chấm (judge) ---
# Model judge chính thức nằm trong configs/eval.toml. Để trống thì dùng chung key/URL ở trên.
JUDGE_API_KEY=
JUDGE_BASE_URL=
